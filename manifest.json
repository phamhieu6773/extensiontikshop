{
  "manifest_version": 3,
  "name": "POD Crawler",
  "version": "1.0.0",
  "description": "Lấy (crawl) sản phẩm từ Etsy, Amazon, eBay, Redbubble, SHEIN, AliExpress, TikTok Shop — sửa, xuất CSV/JSON, tải ảnh và đồng bộ lên server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "POD Crawler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "permissions": ["storage", "unlimitedStorage", "downloads", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.etsy.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.in/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.sg/*",
        "*://*.amazon.ae/*",
        "*://*.ebay.com/*",
        "*://*.ebay.co.uk/*",
        "*://*.ebay.de/*",
        "*://*.ebay.com.au/*",
        "*://*.ebay.ca/*",
        "*://*.ebay.fr/*",
        "*://*.ebay.it/*",
        "*://*.ebay.es/*",
        "*://*.redbubble.com/*",
        "*://*.shein.com/*",
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["content/sites.js", "content/extract.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
